generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
}

model Student {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  enrolled  Boolean  @default(true)
  createdAt DateTime @default(now())
  grades    Grade[]
  attendances Attendance[]
}

model Class {
  id        String   @id @default(cuid())
  name      String
  teacherId String?
  createdAt DateTime @default(now())
}

model Attendance {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  date       DateTime
  present    Boolean
}

model Grade {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  score      Float
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
